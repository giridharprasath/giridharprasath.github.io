---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Posts">
  <section class="page-intro">
    <span class="eyebrow">posts</span>
    <h1>Posts</h1>
  </section>
  <section class="post-list" aria-label="Posts">
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-meta">{post.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' })}</div>
        <h2><a class="post-card-link" href={`/post/${post.id}/`}>{post.data.title}</a></h2>
        {post.data.summary && <p>{post.data.summary}</p>}
        <div class="post-tags">
          {post.data.tags?.map((tag) => <a href={`/tags/${tag.toLowerCase()}/`}>#{tag}</a>)}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
