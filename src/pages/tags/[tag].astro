---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];
  return tags.map((tag) => ({ params: { tag: tag.toLowerCase() }, props: { tag, posts } }));
}

const { tag, posts } = Astro.props;
const matchingPosts = posts
  .filter((post) => post.data.tags?.some((postTag) => postTag.toLowerCase() === tag.toLowerCase()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={`#${tag}`}>
  <section class="page-intro">
    <span class="eyebrow">tag archive</span>
    <h1>#{tag}</h1>
  </section>
  <section class="post-list" aria-label={`Posts tagged ${tag}`}>
    {matchingPosts.map((post) => (
      <article class="post-card">
        <div class="post-meta">{post.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' })}</div>
        <h2><a class="post-card-link" href={`/post/${post.id}/`}>{post.data.title}</a></h2>
        {post.data.summary && <p>{post.data.summary}</p>}
      </article>
    ))}
  </section>
</BaseLayout>