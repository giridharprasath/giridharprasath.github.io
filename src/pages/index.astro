---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Home">
  <section class="page-intro">
    <h1>Posts</h1>
    <div class="profile-links" aria-label="Profile links">
      <a href="https://github.com/GiridharPrasath">github</a>
      <a href="https://twitter.com/z3phyrrrrr">twitter</a>
      <a href="https://www.linkedin.com/in/giridhar-prasath-r-601316b8">linkedin</a>
    </div>
  </section>
  <section aria-labelledby="posts">
    <div class="eyebrow" id="posts">posts</div>
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-card">
          <div class="post-meta">{post.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' })}</div>
          <h2><a class="post-card-link" href={`/post/${post.id}/`}>{post.data.title}</a></h2>
          {post.data.summary && <p>{post.data.summary}</p>}
          <div class="post-tags">
            {post.data.tags?.map((tag) => <a href={`/tags/${tag.toLowerCase()}/`}>#{tag}</a>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
