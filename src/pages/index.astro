---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Home">
  <section class="page-intro">
    <span class="eyebrow">software / security / cryptography</span>
    <h1>Notes from the low level.</h1>
    <p>Writing about systems, security, reverse engineering, and the occasional mathematical detour.</p>
  </section>
  <section aria-labelledby="recent-writing">
    <div class="eyebrow" id="recent-writing">recent writing</div>
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-card" href={`/post/${post.id}/`}>
          <div class="post-meta">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
          <h2>{post.data.title}</h2>
          {post.data.summary && <p>{post.data.summary}</p>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
