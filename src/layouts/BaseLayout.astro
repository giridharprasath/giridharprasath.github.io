---
import '../styles/site.css';

const { title = 'z3phyr', description = 'Security, systems, and cryptography notes.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | z3phyr</title>
    <link rel="stylesheet" href="/styles/katex.min.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">z3phyr</a>
      <nav aria-label="Primary navigation">
        <a href="/post/">writing</a>
        <a href="/about/">about</a>
        <a href="/pdf/cv.pdf">cv</a>
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a href="https://github.com/GiridharPrasath">github</a>
        <a href="https://twitter.com/z3phyrrrrr">twitter</a>
        <a href="https://www.linkedin.com/in/giridhar-prasath-r-601316b8">linkedin</a>
      </div>
      <span>© 2026 z3phyr</span>
    </footer>
  </body>
</html>
